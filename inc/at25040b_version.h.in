#ifndef AT25040B_VERSION_H
#define AT25040B_VERSION_H

/** Major version: incompatible API changes. */
#define AT25040B_VERSION_MAJOR @AT25040B_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define AT25040B_VERSION_MINOR @AT25040B_VERSION_MINOR@
/** Patch version: fixes. */
#define AT25040B_VERSION_PATCH @AT25040B_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define AT25040B_VERSION_STRING "@AT25040B_VERSION@"

#endif // AT25040B_VERSION_H
